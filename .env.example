# ── Google OAuth 2.0 (Gmail integration) ─────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Application type: Desktop app
# Redirect URI: http://127.0.0.1:14220/callback
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# ── LinkedIn OAuth 2.0 ────────────────────────────────────────────────────────
# Create app at: https://www.linkedin.com/developers/apps
# Add product: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
# Redirect URI: http://localhost:14220/callback
LINKEDIN_CLIENT_ID="YOUR_LINKEDIN_CLIENT_ID"
LINKEDIN_CLIENT_SECRET="YOUR_LINKEDIN_CLIENT_SECRET"

# ── For production releases ───────────────────────────────────────────────────
# These same keys must be added to GitHub repo:
#   Settings → Secrets and variables → Actions → New repository secret
# Names: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, LINKEDIN_CLIENT_ID, LINKEDIN_CLIENT_SECRET
