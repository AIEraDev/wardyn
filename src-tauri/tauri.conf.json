{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wardyn",
  "version": "0.1.0",
  "identifier": "com.wardyn.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wardyn",
        "width": 960,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "maxWidth": 1600,
        "maxHeight": 1200,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
